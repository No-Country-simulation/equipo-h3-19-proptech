// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  country   String
  email     String    @unique
  phone     Int
  role      Role      @default(inversor)
  password  String
  isDeleted Boolean   @default(false)
}

enum Role {
  admin
  inversor
  borrower
  sealer
  partner
  guest
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Token {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     Int
  expiresAt DateTime
}